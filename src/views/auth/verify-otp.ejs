<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-sm">
      <div class="card-header bg-success text-white text-center py-3">
        <h4 class="mb-0">Xác thực OTP</h4>
      </div>
      <div class="card-body p-4">
        
        <% if (message) { %>
          <div class="alert alert-info"><%= message %></div>
        <% } %>
        
        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <% success = typeof success === 'undefined' ? false : success; %>
        <% if (success !== true) { %>
          <!-- Form nhập OTP -->
          <form action="/verify-otp" method="POST">
            <input type="hidden" name="email" value="<%= email %>">
            <div class="mb-3">
              <label class="form-label fw-bold">Nhập mã OTP (6 số)</label>
              <input type="text" 
                     name="otp" 
                     maxlength="6" 
                     class="form-control text-center fs-3 fw-bold" 
                     placeholder="123456" 
                     required>
            </div>
            <button type="submit" class="btn btn-success w-100 py-2">Xác thực OTP</button>
          </form>
        <% } else { %>
          <!-- Thành công -->
          <div class="text-center py-4">
            <h5 class="text-success mb-3">✅ Xác thực tài khoản thành công!</h5>
            <a href="/login" class="btn btn-primary w-100 py-2">Đăng nhập ngay</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>